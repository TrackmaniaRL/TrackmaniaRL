include README.md
include CHANGELOG.md
include CONTRIBUTING.md
include LICENSE
include NOTICE
include SECURITY.md
recursive-include readme *.md
recursive-include docs/assets *.png *.gif *.jpg
recursive-include docs/diagrams *.md *.spec.json *.py *.excalidraw *.svg *.png *.html
recursive-include scripts *.py
recursive-include examples *.yaml
include docs/*.md
recursive-include docs/benchmarks *.md *.json
recursive-include experiments/sub37 *.py *.md
recursive-include experiments/activation_film *.py
recursive-include docs/reviews *.md
recursive-include tests *.py
recursive-include trackmaniarl/project/openplanet *.as *.md *.toml
include .env-example
global-exclude .env .env.* *.pem *.key *.pt *.pth *.ckpt *.safetensors
global-exclude *.npz *.npy *.mp4 *.mkv *.sqlite3 *.log *.pyc *.pyo
prune artifacts
prune wandb
prune .venv

recursive-include examples *.py *.md
include examples/native_headless/assets.example.json

# Source-only native build. Runtime artifacts and external inputs stay outside.
include native/LICENSE
include native/vendor/trackmania-tas/LICENSE
recursive-include native *.md *.toml *.lock *.rs *.json *.txt
prune native/target
global-exclude *.exe *.dll *.so *.a *.o *.Gbx *.gbx *.pak *.bin *.dmp
